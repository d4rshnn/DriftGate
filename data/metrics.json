{
  "label": "Simulated evaluation",
  "detectionRate": null,
  "falseAlarmRate": null,
  "actionsUntilCaught": null,
  "permissionCheckDetects": null,
  "setup": "Simulated agent sessions covering six attack types and normal activity. Models are trained on normal behavior only and scored on held-out sessions.",
  "metricDefinitions": [
    {
      "key": "detectionRate",
      "label": "Detection rate",
      "definition": "Share of simulated attack sessions that DriftGate flagged before data left the system",
      "formula": "Detected attacks / all attacks"
    },
    {
      "key": "falseAlarmRate",
      "label": "False-alarm rate",
      "definition": "Share of normal agent sessions that were wrongly flagged",
      "formula": "Wrongly flagged normal sessions / all normal sessions"
    },
    {
      "key": "actionsUntilCaught",
      "label": "Actions until caught",
      "definition": "How many agent actions happened between the start of an attack and the first alert, on average",
      "formula": "Mean actions before first alert, over detected attacks"
    },
    {
      "key": "permissionCheckDetects",
      "label": "Plain permission check detects",
      "definition": "Share of the same attacks a credentials-only access check would have flagged",
      "formula": "Attacks flagged by a permission check / all attacks"
    }
  ],
